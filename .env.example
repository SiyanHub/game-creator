# Copy to a PRIVATE .env. Never commit a working API key.
API_KEY=
# Both https://host.example and https://host.example/v1 are supported.
API_BASE_URL=https://gateway.example
# These are compatibility defaults, NOT proof that your provider offers them.
IMAGE_MODEL=gpt-image-2
VISION_MODEL=gpt-5.5
VIDEO_MODEL=doubao-seedance-2-0-260128
IMAGE_VIDEO_MODEL=doubao-seedance-2-0-260128
MUSIC_MODEL=suno-v4.5+
SPEECH_MODEL=tts-1-hd
SPEECH_FALLBACK_MODEL=qwen3-omni-flash
SPEECH_FALLBACK_VOICE=Cherry
# gateway-json preserves the original gateway's image reference protocol.
# Use openai-edits only if your provider supports /v1/images/edits multipart.
IMAGE_EDIT_ADAPTER=gateway-json
# Optional explicit video protocol: seedance or openai-video.
# VIDEO_ADAPTER=seedance
REQUEST_TIMEOUT_MS=120000
